{
  "name": "kaaninhos-mp3",
  "version": "1.0.3",
  "description": "kaaninho's mp3",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "Kaan",
  "license": "ISC",
  "dependencies": {
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.kaaninho.mp3",
    "productName": "kaaninho's mp3",
    "artifactName": "kaaninho's mp3.exe",
    "compression": "maximum",
    "directories": {
      "output": "dist_build"
    },
    "win": {
      "target": "portable",
      "icon": "assets/icon.png",
      "extraResources": [
        "yt-dlp.exe"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    }
  },
  "overrides": {
    "minimatch": "^10.0.0",
    "brace-expansion": "^5.0.0"
  }
}
